// Based on the "arch" preset from https://github.com/LierB/fastfetch,
// recolored to the black/white theme used by the rest of this setup.
//
// Colors are ANSI codes: 97 = bright white, 90 = grey (bright black).
// Values keep the terminal's default foreground.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/ascii/arch.txt",
        "color": {
            "1": "97"
        },
        "padding": {
            "top": 2,
            "right": 6
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "keys": "97",
            "title": "97"
        },
        "percent": {
            // media/battery/etc. tint percentages green/yellow/red by default
            "color": {
                "green": "97",
                "yellow": "97",
                "red": "97"
            }
        }
    },
    "modules": [
        "break",
        "break",
        {
            "type": "title",
            "keyWidth": 10,
            "color": {
                "user": "97",
                "at": "90",
                "host": "97"
            }
        },
        "break",
        // keys are Nerd Font glyphs written as JSON escapes so editors
        // that can't display private-use codepoints don't mangle them
        {
            "type": "os",
            "key": "\uf303 "
        },
        {
            "type": "kernel",
            "key": "\uf17c "
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": "\uf487 "
        },
        {
            "type": "shell",
            "key": "\uf120 "
        },
        {
            "type": "terminal",
            "key": "\uf489 "
        },
        {
            "type": "wm",
            "key": "\uf2d0 "
        },
        {
            "type": "uptime",
            "key": "\uf017 "
        },
        "break",
        {
            "type": "host",
            "format": "{5} {1}",
            "key": "\uf109 "
        },
        {
            "type": "cpu",
            "format": "{1} ({3}) @ {7}",
            "key": "\uf2db "
        },
        {
            "type": "gpu",
            "format": "{2}",
            "hideType": "integrated",
            "key": "\udb82\udcae "
        },
        {
            "type": "memory",
            "key": "\uf538 "
        },
        {
            "type": "disk",
            "folders": "/",
            "key": "\udb80\udeca "
        },
        {
            "type": "monitor",
            "key": "\uf108 "
        },
        "break",
        {
            // greyscale strip instead of the 8-color block:
            // black, grey, white, bright white
            "type": "custom",
            "format": "\u001b[40m   \u001b[100m   \u001b[47m   \u001b[107m   \u001b[0m"
        },
        "break",
        "break"
    ]
}
