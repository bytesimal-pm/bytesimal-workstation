<labwc_config>

  <theme>
    <icon>Papirus-Dark</icon>
    <cornerRadius>0</cornerRadius>
    <font>
      <name>CommitMono Nerd Font Mono</name>
      <size>10</size>
    </font>
  </theme>

  <!-- Alt-Tab: grid of live window thumbnails (labwc >= 0.9), with the
       selected window raised/previewed on the desktop as you cycle. -->
  <windowSwitcher preview="yes" outlines="yes" order="focus">
    <osd show="yes" style="thumbnail" output="focused" thumbnailLabelFormat="%T" />
  </windowSwitcher>

  <!-- Mouse: no acceleration (flat = constant velocity, 1:1 with the
       sensor), speed is a multiplier from -1.0 (slowest) to 1.0 (fastest),
       0.0 = unscaled. Category non-touch = traditional mice only, so a
       touchpad keeps libinput's defaults. Applied by `labwc -r`. -->
  <libinput>
    <device category="non-touch">
      <accelProfile>flat</accelProfile>
      <pointerSpeed>1.0</pointerSpeed>
    </device>
  </libinput>

  <keyboard>
    <default />
    <!-- Toggle wofi app launcher: fires on release so it doesn't
         interfere with other W-<key> combinations. pkill closes an
         already-open wofi instead of stacking a second one. -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute" command="sh -c &quot;pkill -x wofi || wofi --show drun&quot;" />
    </keybind>
    <!-- Clipboard history via cliphist, picked through wofi -->
    <keybind key="W-v">
      <action name="Execute" command="sh -c &quot;cliphist list | wofi --dmenu | cliphist decode | wl-copy&quot;" />
    </keybind>
    <!-- Screenshot to clipboard. Print: drag a region with slurp (Escape
         cancels and nothing is copied; the dimmed overlay / white frame
         match the glass theme). Shift+Print: whole screen.
         The command is a <command> child, not a command="" attribute:
         labwc re-parses attribute values for XML entities, so any '&'
         in them (e.g. '&&') gets mangled. -->
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c 'g=$(slurp -d -b 00000080 -c ffffffff -s 00000000 -w 1 -F "CommitMono Nerd Font Mono") &amp;&amp; grim -g "$g" - | wl-copy'</command>
      </action>
    </keybind>
    <keybind key="S-Print">
      <action name="Execute">
        <command>sh -c 'grim - | wl-copy'</command>
      </action>
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute" command="kitty" />
    </keybind>
    <!-- Fullscreen the focused window (hides the bar and titlebar) -->
    <keybind key="F11">
      <action name="ToggleFullscreen" />
    </keybind>
  </keyboard>

  <windowRules>
    <!-- pavucontrol (opened from the bar's volume widget) behaves as a
         popup: no titlebar, hidden from the taskbar and Alt-Tab, sized
         for the mono font and pinned to the top-right under the bar. -->
    <windowRule identifier="org.pulseaudio.pavucontrol" serverDecoration="no">
      <skipTaskbar>yes</skipTaskbar>
      <skipWindowSwitcher>yes</skipWindowSwitcher>
      <action name="ResizeTo" width="820" height="560" />
      <action name="MoveToEdge" direction="right" snapWindows="no" />
      <action name="MoveToEdge" direction="up" snapWindows="no" />
      <action name="ToggleAlwaysOnTop" />
    </windowRule>
  </windowRules>

</labwc_config>
